{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom Hive Code Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "summary", "assessment", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pull_request", "files_total", "files_analyzed", "truncated", "ai_assisted"],
      "properties": {
        "repository": {"type": "string"},
        "pull_request": {"type": ["integer", "null"], "minimum": 1},
        "files_total": {"type": "integer", "minimum": 0},
        "files_analyzed": {"type": "integer", "minimum": 0, "maximum": 300},
        "truncated": {"type": "boolean"},
        "ai_assisted": {"const": false}
      }
    },
    "summary": {"type": "string"},
    "assessment": {"enum": ["no_changes", "findings_present", "no_configured_findings", "incomplete"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rule_id", "category", "severity", "confidence", "file", "line", "message", "fix"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{4}$"},
          "rule_id": {"type": "string"},
          "category": {"type": "string"},
          "severity": {"enum": ["critical", "major", "minor", "info", "suggestion"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "message": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}
